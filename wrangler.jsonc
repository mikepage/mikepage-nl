{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikepage-nl",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.generated.css"] }],
  "durable_objects": {
    "bindings": [{ "name": "MYMCP", "class_name": "ToolsMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ToolsMcp"] }],
  "ratelimits": [
    { "name": "API_RL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ]
