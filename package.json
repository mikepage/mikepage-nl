{
  "name": "mikepage-nl",
  "type": "module",
  "scripts": {
    "build:posts": "node scripts/build-posts.mjs",
    "build:css": "tailwindcss -i ./src/styles.css -o ./src/styles.generated.css --minify",
    "build": "npm run build:posts && npm run build:css",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.21.0",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.110.0"
  }
}
